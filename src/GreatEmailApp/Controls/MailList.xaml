<!-- FILE: src/GreatEmailApp/Controls/MailList.xaml
     Created: 2026-04-29 | Revised: 2026-04-29 | Rev: 1
     Changed by: Claude Opus 4.7 on behalf of James Reed
     Middle pane — message list with grouping, filter pills, search. -->
<UserControl x:Class="GreatEmailApp.Controls.MailList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GreatEmailApp.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
        <conv:BoolToFontWeightConverter x:Key="BoolWeight" />
        <conv:StringEqualsToBoolConverter x:Key="StrEqBool" />

        <Style x:Key="FilterPill" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="13" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource PaneBackgroundBrush}">
        <DockPanel>
            <!-- Top: search + filter pills -->
            <Border DockPanel.Dock="Top"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                    Padding="12,10">
                <StackPanel>
                    <!-- Folder-scoped basic search. Strict matching on sender display name,
                         sender email, and subject only — never the body. The user wants
                         "no more 8 million false positives when searching for sentrix
                         trying to find mobile sentrix orders." Full-body / advanced search
                         is roadmap item P1-15+. The placeholder text is overlaid via the
                         Tag-bound TextBlock so we don't need a third-party watermark. -->
                    <Border Background="{DynamicResource InputBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="10,0" Height="28">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{StaticResource IconSearch}" Style="{StaticResource IconGlyph}"
                                       FontSize="12" Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TertiaryTextBrush}" />
                            <Grid Grid.Column="1">
                                <TextBlock x:Name="ListSearchPlaceholder"
                                           Text="Search sender or subject"
                                           Foreground="{DynamicResource TertiaryTextBrush}"
                                           FontSize="12" VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
                                <TextBox x:Name="ListSearchBox"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent"
                                         FontSize="12" VerticalAlignment="Center"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         CaretBrush="{DynamicResource PrimaryTextBrush}"
                                         TextChanged="ListSearchBox_TextChanged" />
                            </Grid>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ToggleButton Style="{StaticResource FilterPill}" Content="All"
                                      IsChecked="{Binding Filter, Converter={StaticResource StrEqBool}, ConverterParameter=All, Mode=OneWay}"
                                      Click="Pill_Click" Tag="All" />
                        <ToggleButton Style="{StaticResource FilterPill}" Content="Unread" Margin="4,0,0,0"
                                      IsChecked="{Binding Filter, Converter={StaticResource StrEqBool}, ConverterParameter=Unread, Mode=OneWay}"
                                      Click="Pill_Click" Tag="Unread" />
                        <ToggleButton Style="{StaticResource FilterPill}" Content="Flagged" Margin="4,0,0,0"
                                      IsChecked="{Binding Filter, Converter={StaticResource StrEqBool}, ConverterParameter=Flagged, Mode=OneWay}"
                                      Click="Pill_Click" Tag="Flagged" />
                        <ToggleButton Style="{StaticResource FilterPill}" Content="Mentions" Margin="4,0,0,0"
                                      IsChecked="{Binding Filter, Converter={StaticResource StrEqBool}, ConverterParameter=Mentions, Mode=OneWay}"
                                      Click="Pill_Click" Tag="Mentions" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- List -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <!-- Group header (only shows when needed; controlled in code-behind via attached property would be cleaner;
                                     for Phase 1 we render every group label and let the eye scan — matches the design) -->
                                <TextBlock Text="{Binding Group}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TertiaryTextBrush}"
                                           Margin="14,12,0,4"
                                           Visibility="{Binding IsFirstInGroup, Converter={StaticResource BoolVis}}" />

                                <!-- Unread rows: tinted background + accent strip. Read rows are
                                     transparent and have their foreground dimmed (DataTriggers below
                                     on TextBlocks). The combination — color + tint + weight — gives
                                     three independent visual signals for unread state. Local
                                     Background must NOT be set on the Border start tag, otherwise
                                     it would beat the Style setter. -->
                                <Border x:Name="Row" CornerRadius="6"
                                        Margin="6,1" Padding="0"
                                        MouseLeftButtonDown="Row_Click"
                                        PreviewMouseRightButtonDown="Row_RightClick"
                                        Tag="{Binding}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Unread}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.ContextMenu>
                                        <ContextMenu Opened="MessageMenu_Opened">
                                            <MenuItem Header="Reply" Click="Reply_Click" />
                                            <MenuItem Header="Reply All" Click="ReplyAll_Click" />
                                            <MenuItem Header="Forward" Click="Forward_Click" />
                                            <Separator Style="{StaticResource MenuSeparatorStyle}" />
                                            <MenuItem Header="Mark Read / Unread" Click="ToggleRead_Click" />
                                            <MenuItem Header="Flag / Unflag" Click="ToggleFlag_Click" />
                                            <Separator Style="{StaticResource MenuSeparatorStyle}" />
                                            <MenuItem Header="Archive" Click="Archive_Click" />
                                            <MenuItem x:Name="MoveToMenu" Header="Move to…" />
                                            <MenuItem Header="Junk" Click="Junk_Click" />
                                            <MenuItem Header="Delete" Click="Delete_Click" />
                                            <Separator Style="{StaticResource MenuSeparatorStyle}" />
                                            <MenuItem Header="Create rule from sender…" Click="CreateRule_Click" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Unread accent bar -->
                                        <Border Grid.Column="0" Width="3" CornerRadius="2"
                                                Background="{DynamicResource AccentBrush}" Margin="2,8"
                                                Visibility="{Binding Unread, Converter={StaticResource BoolVis}}" />

                                        <!-- Avatar -->
                                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="16"
                                                Background="{Binding AvatarBrush}" Margin="6,8,10,8"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Avatar}"
                                                       Foreground="White" FontWeight="SemiBold" FontSize="11"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Body -->
                                        <StackPanel Grid.Column="2" Margin="0,8,8,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Sender}"
                                                           FontWeight="{Binding Unread, Converter={StaticResource BoolWeight}}"
                                                           FontSize="13"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Unread}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Text="{Binding Time}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TertiaryTextBrush}"
                                                           Margin="6,1,0,0" />
                                            </Grid>
                                            <TextBlock Text="{Binding Subject}"
                                                       FontSize="12"
                                                       FontWeight="{Binding Unread, Converter={StaticResource BoolWeight}}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Unread}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Preview}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TertiaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                        </StackPanel>

                                        <!-- Right indicators -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,10,12,0" VerticalAlignment="Top">
                                            <TextBlock Text="{StaticResource IconAttach}" Style="{StaticResource IconGlyph}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TertiaryTextBrush}"
                                                       Margin="0,0,4,0"
                                                       Visibility="{Binding HasAttachments, Converter={StaticResource BoolVis}}" />
                                            <TextBlock Text="{StaticResource IconFlagFilled}" Style="{StaticResource IconGlyph}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource RoseBrush}"
                                                       Margin="0,0,4,0"
                                                       Visibility="{Binding Flagged, Converter={StaticResource BoolVis}}" />
                                            <TextBlock Text="{StaticResource IconImportant}" Style="{StaticResource IconGlyph}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource AmberBrush}"
                                                       Visibility="{Binding Important, Converter={StaticResource BoolVis}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
