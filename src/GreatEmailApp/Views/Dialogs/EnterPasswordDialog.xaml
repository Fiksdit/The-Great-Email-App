<!-- FILE: src/GreatEmailApp/Views/Dialogs/EnterPasswordDialog.xaml
     Created: 2026-11-21 | Revised: 2026-11-21 | Rev: 1
     Changed by: Claude Opus 5.5 on behalf of James Reed
     Enter the IMAP password for an account that already exists but has no
     password on this PC (new PC: account list came down via cloud sync, but
     Credential Manager doesn't roam). Tests the login before saving. -->
<Window x:Class="GreatEmailApp.Views.Dialogs.EnterPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter password"
        Height="300" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Enter password"
                   FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   Margin="0,0,0,6" />

        <TextBlock Grid.Row="1" x:Name="SubText"
                   TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Margin="0,0,0,16" />

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="Password"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,0,0,4" />
            <PasswordBox x:Name="Pwd" Padding="8,6" FontSize="13"
                         AutomationProperties.Name="Email account password"
                         PasswordChanged="Pwd_Changed" />
        </StackPanel>

        <TextBlock Grid.Row="3" x:Name="StatusText"
                   FontSize="12" TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Margin="0,4,0,0" />

        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Padding="14,6"
                    Style="{StaticResource SubtleButton}"
                    Click="Cancel_Click" />
            <Button x:Name="OkButton" Content="Connect" Padding="14,6" Margin="8,0,0,0"
                    Style="{StaticResource AccentButton}"
                    IsDefault="True"
                    Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
