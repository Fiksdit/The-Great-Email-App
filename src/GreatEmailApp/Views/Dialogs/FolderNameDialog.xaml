     Simple text-prompt dialog used by New folder / Rename folder. -->
<Window x:Class="GreatEmailApp.Views.Dialogs.FolderNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folder name"
        Height="200" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText"
                   Text="New folder"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   Margin="0,0,0,8" />

        <TextBlock Grid.Row="1" x:Name="HelpText"
                   FontSize="12"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <TextBox Grid.Row="2" x:Name="NameBox"
                 Padding="8,6" FontSize="13"
                 TextChanged="OnTextChanged" />

        <TextBlock Grid.Row="3" x:Name="ErrorText"
                   Foreground="{DynamicResource RedBrush}"
                   FontSize="12" TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   Margin="0,8,0,0" />

        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Padding="14,6"
                    Style="{StaticResource SubtleButton}"
                    IsCancel="True"
                    Click="Cancel_Click" />
            <Button x:Name="OkButton" Content="OK" Padding="14,6" Margin="8,0,0,0"
                    Style="{StaticResource AccentButton}"
                    IsDefault="True"
                    Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
